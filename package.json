{
  "name": "trustiq",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @trustiq/web",
    "build": "npm run build -w @trustiq/core && npm run build -w @trustiq/web",
    "preview": "npm run preview -w @trustiq/web",
    "lint": "oxlint",
    "test": "npm run test -w @trustiq/core",
    "test:db": "bash scripts/db-test.sh",
    "typecheck": "npm run typecheck -w @trustiq/core"
  },
  "devDependencies": {
    "oxlint": "^1.69.0"
  }
}
