# are reproducible. apps/mobile/pubspec.lock is tracked on purpose.
packages/core-dart/pubspec.lock

# Secrets. .env.example is the template; .env never gets committed.
.env
.env.local
.env.*.local

# Generated by scripts/bundle-migrations.sh; regenerate rather than commit.
supabase/all-migrations.sql

# Vendored build output for the Edge Functions; regenerate with
# scripts/vendor-shared.sh rather than committing it.
supabase/functions/_shared/
