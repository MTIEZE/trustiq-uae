# TrustIQ server configuration.
#
# Copy to .env and fill in. .env is gitignored and must stay that way: these
# are the keys to every contract in the system.
#
# Nothing in this file belongs in the Flutter app. See the note on keys below.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Project URL, from Project Settings > API. Safe to share.
SUPABASE_URL=https://your-project-ref.supabase.co

# SERVER ONLY. In the dashboard this is "secret key (default)" on new projects,
# or "service API key" on older ones; the variable keeps the role-based name
# because that is what it grants. Either format works.
#
# This key bypasses row level security entirely, which means it
# can read and write every contract, dispute and piece of evidence belonging to
# every user. The whole security model in supabase/migrations is written in RLS
# policies, and this key ignores all of them.
#
# It belongs in a server process you control. It must never appear in:
#   - the Flutter app (apps/mobile), including its build config
#   - the web app (apps/web)
#   - anything shipped to a device or a browser
#   - a git commit
#
# A shipped service-role key is not a bug to fix later; it is a full breach the
# moment someone opens the bundle.
SUPABASE_SERVICE_ROLE_KEY=

# The public key the apps use. In the dashboard this is "publishable key" on
# new projects, or "anonymous API key" on older ones. It is designed to be
# public: RLS is what protects the data.
#
# Needed here so scripts/verify-supabase.mjs can check that a public caller
# really is locked out. Getting these two the wrong way round is the mistake
# that matters, so the script refuses to run if they hold the same value.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------

# Used by the dispute resolution pipeline. Server only, for the same reason: an
# API key in a mobile build is a public API key.
ANTHROPIC_API_KEY=
